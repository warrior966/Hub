rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'admin'
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.active != false;
    }

    function isActiveUser() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'user'
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.active != false;
    }

    match /admins/{uid} {
      allow get: if signedIn() && request.auth.uid == uid || isAdmin();
      allow list, create, update, delete: if isAdmin();
    }

    // Admins manage user roles. A user can only read their own role document.
    match /users/{uid} {
      allow get: if (signedIn() && request.auth.uid == uid) || isAdmin();
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // Regular users can only read published websites; admins manage the full library.
    match /websites/{websiteId} {
      allow read: if isAdmin() || (isActiveUser() && resource.data.published == true);
      allow create, update, delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}